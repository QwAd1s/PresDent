# ─── Сервер ────────────────────────────────────────────────────────────────
PORT=8787
# Публичный адрес, по которому Meta достучится до вебхуков (ngrok / cloudflared)
PUBLIC_URL=https://your-tunnel.ngrok-free.app

# ─── WhatsApp Cloud API ────────────────────────────────────────────────────
# Meta → App → WhatsApp → Configuration → Webhook
WHATSAPP_VERIFY_TOKEN=president-wa-verify
# System User / Permanent token with whatsapp_business_messaging
WHATSAPP_TOKEN=
# Phone number ID из WhatsApp Manager
WHATSAPP_PHONE_NUMBER_ID=

# ─── Instagram Messaging (через страницу Facebook) ─────────────────────────
INSTAGRAM_VERIFY_TOKEN=president-ig-verify
INSTAGRAM_PAGE_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# ─── Meta app ──────────────────────────────────────────────────────────────
# App Secret — для проверки подписи X-Hub-Signature-256
META_APP_SECRET=

# ─── База данных ───────────────────────────────────────────────────────────
# json — файл server/data/db.json (по умолчанию, без настройки)
# pglite — настоящий PostgreSQL в WASM, данные в PGLITE_DIR (локально, без сервера)
# postgres — обычный сервер, нужен DATABASE_URL
DB_DRIVER=json
# DATABASE_URL=postgresql://user:password@host:5432/president?sslmode=require
# PGLITE_DIR=server/data/pglite

# ─── Напоминания и уведомления ─────────────────────────────────────────────
# Планировщик напоминаний (за N часов до приёма, отзыв после визита)
REMINDERS_ENABLED=true
REMINDERS_TICK_MS=60000

# Telegram: бот для напоминаний и уведомлений сотрудникам
TELEGRAM_BOT_TOKEN=
TELEGRAM_STAFF_CHAT_ID=

# SMS-провайдер (любой HTTP API с Bearer-токеном)
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=PresiDent

# ─── Прочее ────────────────────────────────────────────────────────────────
# Мок-режим: не отправлять реальные сообщения в Meta, только логировать
DRY_RUN=true

# ─── Доступы ───────────────────────────────────────────────────────────────
# Пароль сотрудников при первом создании базы (owner / admin / doctor)
SEED_PASSWORD=president2026
# Secure-cookie: включается автоматически при NODE_ENV=production
COOKIE_SECURE=false
