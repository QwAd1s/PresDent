# ─── Сервер ────────────────────────────────────────────────────────────────
PORT=8787
# Публичный адрес, по которому Meta достучится до вебхуков (ngrok / cloudflared)
PUBLIC_URL=https://your-tunnel.ngrok-free.app

# ─── WhatsApp Cloud API ────────────────────────────────────────────────────
# Meta → App → WhatsApp → Configuration → Webhook
WHATSAPP_VERIFY_TOKEN=president-wa-verify
# System User / Permanent token with whatsapp_business_messaging
WHATSAPP_TOKEN=
# Phone number ID из WhatsApp Manager
WHATSAPP_PHONE_NUMBER_ID=

# ─── Instagram Messaging (через страницу Facebook) ─────────────────────────
INSTAGRAM_VERIFY_TOKEN=president-ig-verify
INSTAGRAM_PAGE_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# ─── Meta app ──────────────────────────────────────────────────────────────
# App Secret — для проверки подписи X-Hub-Signature-256
META_APP_SECRET=

# ─── Прочее ────────────────────────────────────────────────────────────────
# Мок-режим: не отправлять реальные сообщения в Meta, только логировать
DRY_RUN=true
